# Nutribuddy AI backend (FastAPI)
REACT_APP_BACKEND_URL=http://localhost:8001

# Optional: default platform for order links when an item has no source_platform
# REACT_APP_ORDER_PLATFORM=ubereats

# Optional: free-tier searches per day for the paywall stub (default 5)
# REACT_APP_FREE_SEARCHES_PER_DAY=5

# Optional: disable the paywall stub entirely (demos also work with ?paywall=off)
# REACT_APP_DISABLE_PAYWALL=true

# BiteRush first-party app (biterush/ in this monorepo, customer frontend)
# REACT_APP_BITERUSH_URL=http://localhost:5173
