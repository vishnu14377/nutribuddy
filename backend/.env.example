# OpenAI API Configuration (required)
OPENAI_API_KEY=sk-...

# Pinecone API Configuration (required)
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=nutribuddy-index

# Database Configuration
DB_PATH=./data/nutribuddy.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Optional: ISO 4217 code applied to ingested items that omit currency.
# Leave unset to store unknown-currency items honestly (UI shows a bare number).
# DEFAULT_CURRENCY=USD

# Optional: when set, POST /api/ingest/* and DELETE /api/recipes/clear require
# a matching X-Admin-Token header. Unset = open (local dev).
# ADMIN_API_TOKEN=change-me
